# Copy to /etc/300seconds/jev-observer.env on Nano; owner root, mode 0600.
# OpenCode Console/Zen key. This is NOT a TypeSafe API key.
OPENCODE_API_KEY=
# Free model only; the observer rejects paid model IDs.
JEV_MODEL=jev-1.13-free
JEV_DASHBOARD_URL=http://192.168.184.76:8000
# Camera 0: learner/seat; camera 1: desk/materials. Verify actual mounting.
JEV_PERSON_CAMERA=0
JEV_DESK_CAMERA=1
# Normalized x,y,width,height of the designated seat in the person camera.
JEV_SEAT_ROI=0,0,1,1
# Three snapshots per camera, one second apart; no background upload loop.
JEV_SAMPLES=3
JEV_SAMPLE_INTERVAL=1
