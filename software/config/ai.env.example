# sudoedit /etc/300seconds/ai.env ; sudo chmod 600 /etc/300seconds/ai.env
# Keys stay on the Nano. Never commit this populated file.
GEMINI_API_KEY=
OPENAI_API_KEY=
# Keep 0 until billing/credits are verified. Key authentication alone is not a free inference tier.
NANO_ALLOW_OPENAI_INFERENCE=0
TYPESAFE_API_KEY=
TYPECAST_API_KEY=
NANO_TTS_BACKEND=typecast
NANO_TYPECAST_MODEL=ssfm-v30
# Set to a verified built-in voice from GET /v3/voices.
NANO_TYPECAST_VOICE_ID=
NANO_TYPECAST_ALLOW_PAID=0
# Independent character cap; TTS never consumes the Gemini request budget.
NANO_TTS_MAX_24H_CHARS=500
NANO_TTS_MAX_30D_CHARS=12000
NANO_ALLOW_CLOUD=1
NANO_DECISION_PROVIDER=gemini
NANO_GENERATION_PROVIDER=gemini
NANO_GEMINI_MODEL=gemini-3.5-flash-lite
NANO_OPENAI_MODEL=gpt-4.1-mini
NANO_DECISIONS_MODEL=gpt-6-luna
NANO_JEV_MODEL=jev-1.14
# This is a LOCAL combined-provider attempt cap, not an official account quota.
NANO_AI_MAX_RPM=1
NANO_AI_MAX_24H=10
