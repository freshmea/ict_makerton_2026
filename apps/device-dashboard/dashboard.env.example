# Wi-Fi IPv4 is detected at runtime; do not persist a DASHBOARD_BIND address.
DASHBOARD_RUNTIME=/run/300seconds-dashboard
DASHBOARD_SETTINGS=/var/lib/300seconds-dashboard/settings.json
DASHBOARD_AUDIO_SETTINGS=/var/lib/300seconds-dashboard/audio-settings.json
DASHBOARD_LEARNING_DB=/var/lib/300seconds-dashboard/learning.sqlite3
LEARNING_AUTOSTART=0
CAMERA_ENCODER=omxh264enc
PICO_BIN=/opt/300seconds/dashboard/pico-device-bench
