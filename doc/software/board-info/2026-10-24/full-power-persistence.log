[Unit]
Description=nvpmodel service
; Everything depends on the NVIDIA per-boot script
After=nv.service
Requires=nv.service
; TPC power gating must be enabled before anything touching gpu
Before=graphical.target
Before=gdm3.service lightdm.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/nvpmodel -f /etc/nvpmodel.conf

[Install]
WantedBy=multi-user.target
enabled
FILE /var/lib/nvpmodel/status
pmode:0001 fmode:fanNullFILE /etc/nvpmodel.conf
# < POWER_MODEL ID=id_num NAME=mode_name >
# This starts a section of POWER_MODEL configurations, followed by
# This file must contain at least one POWER_MODEL section.
# < PM_CONFIG DEFAULT=default_mode >
< PARAM TYPE=FILE NAME=CPU_ONLINE >
# POWER_MODEL DEFINITIONS #
< POWER_MODEL ID=0 NAME=MAXN >
CPU_ONLINE CORE_0 1
CPU_ONLINE CORE_1 1
CPU_ONLINE CORE_2 1
CPU_ONLINE CORE_3 1
CPU_A57 MAX_FREQ -1
GPU MAX_FREQ -1
< POWER_MODEL ID=1 NAME=5W >
CPU_ONLINE CORE_0 1
CPU_ONLINE CORE_1 1
CPU_ONLINE CORE_2 0
CPU_ONLINE CORE_3 0
CPU_A57 MAX_FREQ 918000
GPU MAX_FREQ 640000000
< PM_CONFIG DEFAULT=0 >
FILE /sys/devices/system/cpu/online
0-1
FILE /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq
921600
FILE /sys/devices/57000000.gpu/devfreq/57000000.gpu/max_freq
614400000
