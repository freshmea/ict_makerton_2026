ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Six CLS6336HV servo envelopes, three serial revolute joints per arm: yaw Z, shoulder pitch local Y, wrist roll local X. Actual wrist servo/core/horn/bearing rebuilt coaxially in X, with removable bearing cap. Neutral save; +/-15 degree provisional CAD limits only.'),'2;1');
FILE_NAME('fold_wing_v8_P5_RPY_assembly.step','',(''),(''),'SolidCraft','SolidCraft','');
